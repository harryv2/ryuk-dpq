# Copy to .env and edit. Anything already set in the real environment wins, so
# a run configuration or a shell override beats this file without editing it.
#
#   .env            both services
#   .env.gateway    just the gateway      } read before .env, so they win
#   .env.node       just a node           }
#   RYUK_ENV_FILE   an explicit path, beats both
#
# Defaults match `make infra`: Postgres, etcd and Prometheus in Docker with
# their ports published, and the Go processes run from an IDE.

# ---- both ----
RYUK_LOG_LEVEL=info
RYUK_LOG_FORMAT=text
RYUK_ETCD=localhost:2379

# ---- gateway ----
RYUK_LISTEN=:8080
RYUK_POSTGRES=postgres://ryuk:ryuk@localhost:5432/ryuk?sslmode=disable
RYUK_PROMETHEUS=http://localhost:9091
RYUK_STATIC_DIR=frontend/out
RYUK_CACHE_TTL=30s
RYUK_COLLECT_EVERY=1s

# ---- node ----
# One per instance: change the port and the data directory, since a node takes
# its identity from that directory and two sharing one fight over the same id.
# RYUK_LISTEN=:9110
# RYUK_ADVERTISE=localhost:9110
# RYUK_DATA_DIR=./data/dev/node1
# RYUK_WAL_SYNC=interval
# RYUK_SWEEP_EVERY=200ms
# RYUK_LEASE_TTL=10
